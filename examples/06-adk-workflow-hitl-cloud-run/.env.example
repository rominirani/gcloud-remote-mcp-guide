# Google Cloud Project & Compute Target
GOOGLE_CLOUD_PROJECT="your-project-id"
GOOGLE_CLOUD_REGION="us-central1"
GOOGLE_CLOUD_ZONE="us-central1-a"

# Gemini 3 Flash Preview requires global endpoint
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI="TRUE"

# Vertex AI Agent Engine Session Service (regional endpoint + numeric ReasoningEngine ID)
AGENT_ENGINE_LOCATION="us-central1"
GOOGLE_CLOUD_AGENT_ENGINE_ID="YOUR_AGENT_ENGINE_ID"
